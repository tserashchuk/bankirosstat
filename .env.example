# Database (sqlite by default)
DATABASE_URL=sqlite:///./data/project_hub.db

# Логи: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Fernet key for encrypting source credentials in DB
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LLM API keys (global; models without keys are disabled in UI)
GEMINI_API_KEY=
# Optional override (по умолчанию в UI: gemini-2.5-pro, также доступен gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-pro
# Если Gemini недоступен по региону (400 location is not supported):
# DEFAULT_LLM_MODEL=deepseek-v3
# Прокси/зеркало Gemini API (опционально):
# GOOGLE_GEMINI_BASE_URL=https://your-proxy.example/v1beta

# Таймаут одного запроса к ИИ, секунды (портфель = несколько запросов подряд)
LLM_TIMEOUT_SECONDS=600
# Лимит JSON в промпте и повторы при обрыве соединения с Gemini
LLM_MAX_CONTEXT_CHARS=80000
LLM_MAX_FIELD_CHARS=4000
LLM_RETRY_COUNT=3
# При сбое Pro автоматически повторить запрос через Flash
GEMINI_FALLBACK_TO_FLASH=true
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=sk-27c9fd2fef7747aa9e7363258f896f33

# Optional: DeepSeek base URL (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gamma API (presentation generation)
GAMMA_API_KEY=
# Optional: Gamma API base URL
GAMMA_BASE_URL=https://public-api.gamma.app/v1.0
# Язык слайдов (ru, en, uk, …) — для генерации с нуля (POST /generations)
GAMMA_LANGUAGE=ru
# ID шаблона Gamma (File ID, одна страница) — POST /generations/from-template
GAMMA_TEMPLATE_ID=Bankiros-m15hcuhf4vcyszl

# Redis для фоновой очереди задач (ARQ worker)
REDIS_URL=redis://localhost:6379/0
# Таймаут одной задачи в воркере, секунды
JOBS_WORKER_TIMEOUT=1800
# Сколько задач одновременно в одном воркере
JOBS_WORKER_CONCURRENCY=4
